64c48f23dd10c923b8ee85a46876", "computed_md5": "76cd64c48f23dd10c923b8ee85a46876", "mimetype": "text/plain"}], "folder_structure": {}, "authors": [{"id": 3889309, "full_name": "Brian Lindauer", "first_name": "Brian", "last_name": "Lindauer", "is_active": true, "url_name": "Brian_Lindauer", "orcid_id": ""}], "custom_fields": [{"name": "Publisher Statement", "value": "", "settings": {"validations": {"min_length": 2, "max_length": 2000}, "placeholder": "Add the text and full citation to the published version."}, "field_type": "textarea", "order": null, "is_mandatory": false}, {"name": "Date", "value": "2014-10-19", "settings": {}, "field_type": "date", "order": null, "is_mandatory": false}, {"name": "Copyright Statement", "value": "", "settings": {"validations": {"min_length": 10, "max_length": 1000}, "placeholder": "Enter a copyright statement"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://kilthub.cmu.edu/articles/dataset/Insider_Threat_Test_Dataset/12841247", "download_disabled": false, "description": "<p>The Insider Threat Test Dataset is a collection of synthetic insider threat test datasets that provide both background and malicious actor synthetic data.<br></p><p><br></p><p>The CERT Division, in partnership with ExactData, LLC, and under sponsorship from DARPA I2O, generated a collection of synthetic insider threat test datasets. These datasets provide both synthetic background data and data from synthetic malicious actors.</p><p>For more background on this data, please see the paper, <a href=\"https://ieeexplore.ieee.org/document/6565236\">Bridging the Gap: A Pragmatic Approach to Generating Insider Threat Data</a>.</p><p>Datasets are organized according to the data generator release that created them. Most releases include multiple datasets (e.g., r3.1 and r3.2). Generally, later releases include a superset of the data generation functionality of earlier releases. Each dataset file contains a readme file that provides detailed notes about the features of that release.</p><p>The answer key file answers.tar.bz2 contains the details of the malicious activity included in each dataset, including descriptions of the scenarios enacted and the identifiers of the synthetic users involved.</p>", "funding": "DARPA FA8721-05-C-0003", "funding_list": [{"id": 19003217, "title": "DARPA FA8721-05-C-0003", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 93667406290, "created_date": "2020-09-30T15:36:53Z", "modified_date": "2023-05-30T10:25:18Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Insider Threat", "Software Engineering"], "keywords": ["Insider Threat", "Software Engineering"], "categories": [{"id": 35954, "title": "Software engineering not elsewhere classified", "parent_id": 35927, "path": "/35549/35927/35954", "source_id": "461299", "taxonomy_id": 102}], "references": ["https://doi.org/10.1109/SPW.2013.37"], "has_linked_file": false, "citation": "Lindauer, Brian (2020). Insider Threat Test Dataset. Carnegie Mellon University. Dataset. https://doi.org/10.1184/R1/12841247.v1", "related_materials": [{"id": 142346, "identifier": "10.1109/SPW.2013.37", "title": "Bridging the Gap: A Pragmatic Approach to Generating Insider Threat Data", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1109/SPW.2013.37"}], "is_embargoed": false, "embargo_date": null, "embargo_type": "file", "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 12841247, "title": "Insider Threat Test Dataset", "doi": "10.1184/R1/12841247.v1", "handle": "", "url": "https://api.figshare.com/v2/articles/12841247", "published_date": "2020-09-30T15:36:53Z", "thumb": "", "defined_type": 3, "defined_type_name": "data