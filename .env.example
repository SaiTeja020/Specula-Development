# =============================================================================
# Specula — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
#
# Variables marked [REQUIRED to go live] must be set for that feature to work.
# Variables marked [OPTIONAL] have a safe default and can be left as-is.
# Variables marked [DEFAULT: stub] mean the feature is off until you change it.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM BACKEND
# -----------------------------------------------------------------------------

# Which LLM backend to use for all agents.
# "stub"   -> no API key needed; deterministic canned responses (safe default)
# "gemini" -> calls Google Gemini API (requires GEMINI_API_KEY below)
SPECULA_LLM_BACKEND=stub                        # [DEFAULT: stub]

# Google Gemini API key.
# Get one at: https://aistudio.google.com/app/apikey
# Only required when SPECULA_LLM_BACKEND=gemini
GEMINI_API_KEY=                                 # [REQUIRED for gemini backend]


# -----------------------------------------------------------------------------
# NEO4J (Digital Forensics Knowledge Graph)
# -----------------------------------------------------------------------------

# URI of your Neo4j instance (matches docker-compose service)
NEO4J_URI=bolt://localhost:7687                 # [OPTIONAL -- default shown]

# Neo4j credentials
NEO4J_USER=neo4j                                # [OPTIONAL -- default shown]
NEO4J_PASSWORD=                                 # [REQUIRED if auth enabled]

# Set to "true" to enable live Neo4j writes in run_pipeline.py
SPECULA_NEO4J_ENABLED=false                     # [DEFAULT: false]


# -----------------------------------------------------------------------------
# KAFKA / REDPANDA
# -----------------------------------------------------------------------------

# Kafka broker address (matches docker-compose service)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092          # [OPTIONAL -- default shown]


# -----------------------------------------------------------------------------
# REDIS (LangGraph Checkpointer)
# -----------------------------------------------------------------------------

# Redis URL used by the LangGraph checkpoint store
REDIS_URL=redis://localhost:6379                # [OPTIONAL -- default shown]


# -----------------------------------------------------------------------------
# QUICKWIT (Append-only WORM log store)
# -----------------------------------------------------------------------------

# Set to "true" to enable live Quickwit writes in run_pipeline.py
SPECULA_QUICKWIT_ENABLED=false                  # [DEFAULT: false]


# -----------------------------------------------------------------------------
# NVD / NIST CVE FEED (Threat Intel Corpus)
# -----------------------------------------------------------------------------

# NVD API key for higher rate limits when building the threat-intel FAISS index.
# Without a key: 5 requests / 30 s  (very slow for full corpus build)
# With a key:    50 requests / 30 s
# Register free at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=                                    # [OPTIONAL -- works without, just slower]


# -----------------------------------------------------------------------------
# MEMORY FORENSICS (WinPmem + Volatility3)
# -----------------------------------------------------------------------------
# Memory forensics acquires a live RAM image with WinPmem then runs Volatility3
# plugins (pslist, netscan, malfind) to extract processes, network connections,
# and injected code regions into the DFKG.
#
# SETUP REQUIRED before enabling live mode:
#   1. Download winpmem_mini_x64.exe from:
#      https://github.com/Velocidex/WinPmem/releases/latest
#      Place at: tools/winpmem_mini_x64.exe
#   2. Volatility3 is already installed via requirements.txt.
#   3. Download Windows symbol pack (~300 MB) from:
#      https://downloads.volatilityfoundation.org/volatility3/symbols/windows.zip
#      Extract the windows\ folder into:
#      venv\lib\site-packages\volatility3\framework\symbols\windows\
#   4. Run pipeline as Administrator (WinPmem requires raw physical memory access).
#
# MOCK MODE (no tools required — safe for dev/CI):
#   Set SPECULA_MEMORY_MOCK=true to use synthetic fixture records instead.
#   Tests always run in mock mode; no hardware or elevated privileges needed.

# Set to "true" to include memory forensics in the ingestion run.
SPECULA_MEMORY_ENABLED=false                    # [DEFAULT: false]

# Set to "true" to use synthetic fixture records (no WinPmem/Volatility3 needed).
# Overrides live acquisition when SPECULA_MEMORY_ENABLED=true.
SPECULA_MEMORY_MOCK=false                       # [DEFAULT: false]

# Absolute or repo-relative path to winpmem_mini_x64.exe
SPECULA_WINPMEM_PATH=tools/winpmem_mini_x64.exe # [REQUIRED for live memory]

# Absolute or repo-relative path to the Volatility3 vol.py entry-point.
# After pip install volatility3, it will be at venv/Scripts/vol.py (Windows).
SPECULA_VOL3_PATH=venv/Scripts/vol.py           # [REQUIRED for live memory]

# Directory where the temporary raw memory image is written during acquisition.
# The image is deleted automatically after Volatility3 finishes.
SPECULA_MEMORY_DUMP_DIR=data/extracted_logs     # [OPTIONAL -- default shown]
